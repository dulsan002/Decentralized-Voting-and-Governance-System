# Deployment (DO NOT commit real values)
DEPLOYER_PRIVATE_KEY=your_private_key_here
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your_key_here

# MongoDB Database
MONGODB_URI=mongodb+srv://your_user:<password>@your_cluster.mongodb.net/decentravote?retryWrites=true&w=majority

# Frontend (safe to commit - public values)
NEXT_PUBLIC_CONTRACT_ADDRESS=deployed_contract_address
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=https://sepolia.infura.io/v3/your_key_here
