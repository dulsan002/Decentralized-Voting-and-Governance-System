{
  "name": "decentravote",
  "version": "1.0.0",
  "private": true,
  "description": "DecentraVote — A Blockchain-Based Decentralized Voting and Governance System",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "init:local": "hardhat compile && hardhat run scripts/deploy.js --network localhost && hardhat run scripts/fund.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.1",
    "clsx": "^2.1.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.11.1",
    "lucide-react": "^0.344.0",
    "mongodb": "^6.12.0",
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.0",
    "autoprefixer": "^10.4.18",
    "chai": "^4.5.0",
    "hardhat": "^2.19.5",
    "hardhat-gas-reporter": "^2.3.0",
    "postcss": "^8.4.35",
    "solidity-coverage": "^0.8.17",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^7.0.2"
  }
}
